<%# [slide: id, n, size] — see DocTemplate::Tags::SlideTag. A left-aligned
    block (no text beside it) whose width is a percentage of the page or table
    cell; the thumbnail links to the slide. %>
<div class="o-ld-slide">
  <% if @tmpl[:slide_url] %><a href="<%= @tmpl[:slide_url] %>"><% end %><img class="o-ld-slide__img" src="<%= @tmpl[:image_src] %>" alt="<%= @tmpl[:alt] %>" style="width: <%= @tmpl[:size] %>%;"/><% if @tmpl[:slide_url] %></a><% end %>
</div>
