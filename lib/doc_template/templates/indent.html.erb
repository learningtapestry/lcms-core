<div class="u-ld-indented">
  <%# html_safe: IndentTag#parsed_content ends in "#{prepend_html}#{html}", and
      interpolation builds a new plain String — the html_safe flag on
      parse_nested's result does not survive it. Escaping prints every [indent]
      block's markup as literal text. (.to_s.html_safe rather than `raw`: `raw`
      comes from Tags::Helpers, which IndentTag does not include.) %>
  <%= @tmpl[:content].to_s.html_safe %>
</div>
