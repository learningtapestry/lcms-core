<%# Name/Date fill-in for a Unit Material (material-metadata name-date = Yes): %>
<%# a one-row, two-column table with 1pt black borders. Shared by the PDF and %>
<%# Gdoc unit documents; cell borders are the border form Google Docs keeps. %>
<table class="c-unit-material__namedate o-simple-table">
  <tr>
    <td class="c-unit-material__namedate-cell c-unit-material__namedate-cell--name"><%= t("material.namedate.name") %></td>
    <td class="c-unit-material__namedate-cell"><%= t("material.namedate.date") %></td>
  </tr>
</table>
